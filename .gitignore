# Python caches
__pycache__/
*.pyc

# macOS
.DS_Store

# ephemeral verification stamps (regenerated by check_cards.py)
*.verified

# skill venv (PyMuPDF for figure extraction) — recreate with:
#   python3 -m venv .venv && .venv/bin/pip install PyMuPDF pillow
.venv/

# Figure extraction cache — every plate in a segment, regenerable from the PDF:
#   .venv/bin/python scripts/build_figure_index.py --source <id> --segment <N>
# figure_index.json IS tracked (small, and it carries the descriptions/terms).
work/*/figures/

# Whole-book pdftotext cache for the lexicon evidence finder — large, regenerated on
# demand by lexicon.py --find (mtime-keyed). lexicon_evidence.json IS tracked (small,
# and it is the anchor record the gate verifies).
work/_fulltext/

# Scratch page renders (render_page.py) — regenerable, and NEVER the home of a card's
# cited evidence: deleting them once hard-blocked six physics ch2 cards whose
# visual_source pointed here. Evidence crops belong in runs/<src>/<seg>/<run>/figures/.
work/*/page_*.png

# intermediate wav cuts from khouri_build_clips_0901.py — regenerable from the lecture mp4
work/*/_clipbuild/

# 16 kHz wav extracted from a lecture mp4 for clip-cutting — hundreds of MB, and
# regenerable in one ffmpeg call from the recording in Drive. The CUT clips and the
# gate log that proves what each one says are tracked in runs/<src>/<seg>/<run>/audio/.
work/*/u2audio/*.wav
work/*/*/mlx/*.wav

# publisher videos pulled to harvest a few seconds of narration (Alif Baa writing demos)
work/*/u2audio/vid_*.mp4

# duplicated into the run store as the tracked review artifact
work/*/u2audio/render_*.png
work/*/u2audio/crop_*.png
